{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch NestJS Program",
      "runtimeExecutable": "node",
      "args": ["-r", "ts-node/register", "src/main.ts"],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "preLaunchTask": "npx cross-port-killer 3000"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Debug Server",
      "processId": "${command:PickProcess}",
      "sourceMaps": true,
      "restart": true,
			"port": 9229
    }
  ]
}
